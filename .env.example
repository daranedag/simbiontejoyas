# InsForge: obtain the public key and server API key from the linked project.
NEXT_PUBLIC_INSFORGE_URL=https://nc43x3r8.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_API_KEY=

# The Google account(s) allowed to operate the panel. Separate addresses with commas.
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_APP_URL=https://admin.simbiontejoyas.cl

# ImageKit: the public key can reach the browser; the private key must remain server-only.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=/simbiontejoyas
